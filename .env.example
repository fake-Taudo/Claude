# Kontaktformular – optional.
# Ohne diese Variablen läuft das Formular im Demo-Modus:
# Anfragen werden nur im Server-Log ausgegeben, nicht per E-Mail verschickt.

# API-Key von https://resend.com (kostenloses Kontingent vorhanden)
RESEND_API_KEY=

# An diese Adresse werden Anfragen zugestellt (Standard: contact.email aus content/site.ts)
CONTACT_TO_EMAIL=

# Absender. Bis die eigene Domain bei Resend verifiziert ist, funktioniert:
# Website <onboarding@resend.dev>
CONTACT_FROM_EMAIL=
